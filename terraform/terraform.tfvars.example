# Example variable values.
#
# Every variable already has a default that reproduces this architecture, so
# this file is optional. Copy it and edit it only if you want different values:
#
#   cp terraform.tfvars.example terraform.tfvars
#
# terraform.tfvars is ignored by Git. Nothing secret belongs in it either: the
# database password is generated by RDS and stored in Secrets Manager, and AWS
# credentials come from the provider credential chain, not from variables.

aws_region         = "eu-west-2"
availability_zones = ["eu-west-2a", "eu-west-2b"]

project_name = "project4"

vpc_cidr            = "10.0.0.0/16"
public_subnet_cidrs = ["10.0.1.0/24", "10.0.2.0/24"]
app_subnet_cidrs    = ["10.0.3.0/24", "10.0.4.0/24"]
db_subnet_cidrs     = ["10.0.5.0/24", "10.0.6.0/24"]

instance_type = "t3.micro"

asg_min_size         = 2
asg_desired_capacity = 2
asg_max_size         = 4

db_engine_version          = "8.0"
db_instance_class          = "db.t4g.micro"
db_allocated_storage       = 20
db_name                    = "appdb"
db_username                = "admin"
db_multi_az                = false # true is the only change needed for high availability
db_backup_retention_period = 1

# The address that receives the alarm notifications. Leave it out and no
# subscription is created, which is the safe default for a public repository.
# alert_email = "you@example.com"

cpu_alarm_threshold = 70
log_retention_days  = 7

common_tags = {
  Project     = "Project4"
  Environment = "Lab"
  ManagedBy   = "Terraform"
}
